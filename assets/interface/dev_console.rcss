body {
	font-family: Tahoma;
	font-size: 15px;
	font-weight: 600;
	color: #d7f8d7;
	width: 100%;
	height: 100%;
}

#console_root {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 60%;
	
	display: flex;
	flex-direction: column;
	
	background-color: rgba(0, 0, 0, 210);
	border-bottom: 2px rgba(255, 255, 255, 35);
	z-index: 1000;
}

#console_header {
	padding: 6dp 10dp;
	background-color: rgba(20, 30, 20, 170);
	border-bottom: 1px rgba(255, 255, 255, 25);
	justify-content: space-between;
}

#console_title {
	margin: 0px;
	padding: 0px;
	font-size: 16px;
	color: #a8ffb0;
	font-effect: shadow(1px 1px black);
}

#console_hint {
	margin: 2dp 0px 0px 0px;
	padding: 0px;
	font-size: 12px;
	color: #b3cbb7;
}

#console_log {
	flex: 1;
	padding: 8dp 10dp;
	overflow-y: auto;
	background-color: rgba(0, 0, 0, 0);
	flex-direction: column;
}

.console_line {
	margin: 0px;
	padding: 0px;
	line-height: 18dp;
	flex-shrink: 0;
}

.console_line_cmd {
	color: #a8ffb0;
}

.console_line_err {
	color: #ffb0b0;
}

#console_input_row {
	display: flex;
	flex-direction: row;
	align-items: center;
	
	padding: 6dp 10dp;
	background-color: rgba(20, 30, 20, 190);
	border-top: 1px rgba(255, 255, 255, 25);
}

#console_prompt {
	margin: 0px;
	padding: 0px;
	width: 14dp;
	color: #a8ffb0;
}

input {
	flex: 1;
	height: 24dp;
	
	background-color: rgba(0, 0, 0, 120);
	border: 1px rgba(255, 255, 255, 30);
	border-radius: 3dp;
	padding: 3dp 6dp;
	
	color: #d7f8d7;
}

input:focus {
	border: 1px rgba(168, 255, 176, 120);
}
