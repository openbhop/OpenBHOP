<rml>
<head>
    <title>OpenBHOP Main Menu</title>
    <link type="text/rcss" href="menu.rcss" />
</head>
<body>
    <div id="overlay">
        <div id="panel">
            <h1 id="title">OpenBHOP</h1>
            <div class="button_row">
                <button id="play_button">Play</button>
                <button id="quit_button">Quit</button>
            </div>

            <p id="hint">Tip: Press Esc to close the window.</p>
        </div>
    </div>
</body>
</rml>
