body {
	font-family: Tahoma;
	font-size: 16px;
	font-weight: 600;
	color: #e6e6e6;
	pointer-events: none;
	width: 100%;
	height: 100%;
}

#hud {
	position: absolute;
	left: 50%;
	bottom: 120dp;
	padding: 6dp 10dp;
	background-color: rgba(0, 0, 0, 120);
	border: 1px rgba(255, 255, 255, 40);
	border-radius: 4dp;
	transform: translate(-50%, 0);
	width: 160px;
	justify-content: center;
}

.hud_line {
	margin: 0px;
}

.value {
	font-size: 30px;
	font-weight: 600;
}
